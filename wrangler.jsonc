{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deye-iphone-widget",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "DEYE_CACHE",
      "id": "REPLACE_WITH_CLOUDFLARE_KV_NAMESPACE_ID"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
